#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VENV="$ROOT/.m1-validation-venv"

python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else "Python 3.11+ is required")'
if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/python" -m pip install --disable-pip-version-check -r "$ROOT/requirements.lock"
fi

cd "$ROOT"
"$VENV/bin/python" -m unittest discover -s tests -p 'test_*.py'
"$VENV/bin/python" -m tools.m1.repo_checks

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "software_id",
    "confirmation_stage"
  ],
  "properties": {
    "software_id": {
      "enum": [
        "edge",
        "chrome",
        "firefox",
        "microsoft365",
        "wps",
        "libreoffice",
        "vscode",
        "git",
        "github-cli",
        "node",
        "python",
        "uv",
        "jupyter",
        "ruff",
        "codex-cli",
        "claude-code"
      ]
    },
    "confirmation_stage": {
      "const": "mac_plan"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macwin.example/schemas/habitpack/1.0.0/developer.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "module": {
      "const": "developer"
    },
    "candidates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "allOf": [
          {
            "$ref": "module-envelope.schema.json#/$defs/candidateBase"
          },
          {
            "type": "object",
            "properties": {
              "parameters": {
                "$ref": "developer-params.schema.json"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    }
  }
}

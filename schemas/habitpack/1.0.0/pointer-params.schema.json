{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device",
    "scroll_direction"
  ],
  "properties": {
    "device": {
      "enum": [
        "mouse",
        "trackpad"
      ]
    },
    "scroll_direction": {
      "enum": [
        "natural",
        "windows_style"
      ]
    }
  }
}
